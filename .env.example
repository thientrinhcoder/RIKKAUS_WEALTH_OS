# Local development values only. Do not reuse these credentials outside a local machine.
POSTGRES_DB=rikkaus
POSTGRES_USER=rikkaus
POSTGRES_PASSWORD=rikkaus-local-only
POSTGRES_PORT=5432
DB_URL=jdbc:postgresql://localhost:5432/rikkaus

# Comma-separated browser origins allowed to call /api/v1/** and /actuator/health.
# Empty means no origin is permitted and no CORS mapping is registered at all, which is the
# intended default for every environment that does not explicitly need one. The value below is
# the origin a local `npm --prefix apps/mobile run web` serves on.
API_ALLOWED_ORIGINS=http://localhost:8081

# Signing key for the short-lived JWT access tokens. At least 32 bytes; the application refuses to
# start without it, because a guessable key lets anyone mint a token for any user. Generate one with
# `openssl rand -base64 48`. The value below is a placeholder and must not be used anywhere.
RIKKAUS_JWT_SECRET=replace-me-with-at-least-32-bytes-of-random

# Google OAuth client, from Google Cloud Console. Identity is Google Account OIDC only; there is no
# password. Leave CLIENT_SECRET empty for a public client using PKCE alone.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Comma-separated allowlist of redirect URIs, compared exactly. Empty permits none, which is the
# intended default: the value is forwarded to Google, which delivers the authorization code to
# whatever it names, so an unregistered URI is how a code reaches somewhere it should not. Each entry
# must also be registered on the Google OAuth client.
GOOGLE_OAUTH_REDIRECT_URIS=http://localhost:8081/auth/callback
