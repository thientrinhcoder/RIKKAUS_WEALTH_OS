# Local development values only. Do not reuse these credentials outside a local machine.
POSTGRES_DB=rikkaus
POSTGRES_USER=rikkaus
POSTGRES_PASSWORD=rikkaus-local-only
POSTGRES_PORT=5432
DB_URL=jdbc:postgresql://localhost:5432/rikkaus

# Comma-separated browser origins allowed to call /api/v1/** and /actuator/health.
# Empty means no origin is permitted and no CORS mapping is registered at all, which is the
# intended default for every environment that does not explicitly need one. The value below is
# the origin a local `npm --prefix apps/mobile run web` serves on.
API_ALLOWED_ORIGINS=http://localhost:8081
