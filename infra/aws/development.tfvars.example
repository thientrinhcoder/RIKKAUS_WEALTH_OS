# Copy to development.tfvars and edit. The real file is git-ignored.
#
#   cp development.tfvars.example development.tfvars
#   tofu apply -var-file=development.tfvars

aws_region  = "ap-southeast-1"
environment = "development"

# Must match the repository whose workflow assumes the deploy role, or federation is refused.
github_repository      = "thientrinhcoder/RIKKAUS_WEALTH_OS"
github_deploy_branches = ["main"]

# Set to 0 between test windows to stop paying for Fargate compute without destroying anything;
# set back to 1 and re-apply when the next review starts. The database keeps running either way.
api_desired_count = 1

# Edge locations. PriceClass_200 includes Asia; PriceClass_100 would serve Vietnam from North
# America and Europe and add a round trip to every call.
cloudfront_price_class = "PriceClass_200"

# Browser origins permitted to call the API, comma-separated. Empty registers no CORS mapping at
# all, which is the application's intended default. Fill this in once issue #46 publishes an Expo
# web preview origin.
api_allowed_origins = ""

# Google OAuth, for after issue #42 merges. Until then leave all three empty: no parameter is
# created and the task receives no such variable.
#
# Do not put a real client secret in a file you might commit. Prefer the environment:
#   export TF_VAR_google_oauth_client_secret='...'
google_oauth_client_id     = ""
google_oauth_client_secret = ""

# Exact-match allowlist, comma-separated. Google delivers the authorization code to whatever this
# names, so an unregistered URI is how a code reaches somewhere it should not.
#
# This environment serves HTTPS, so Google will accept a redirect URI here. Use the CloudFront
# hostname from `tofu output -raw api_base_url` — for example
# https://d2x3k9abcdef.cloudfront.net/auth/callback — and register the identical string on the
# Google OAuth client, which compares it character for character.
google_oauth_redirect_uris = ""
