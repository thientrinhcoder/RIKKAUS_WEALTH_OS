<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/>
    </parent>

    <groupId>com.rikkaus</groupId>
    <artifactId>rikkaus-wealth-api</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>Rikkaus Wealth OS API</name>
    <description>Backend modular monolith for Rikkaus Wealth OS</description>

    <properties>
        <java.version>25</java.version>
        <!--
            Pinned deliberately. The architecture document forbids floating versions in the
            build, and an unpinned formatter is the worst offender of the three: a new
            google-java-format release changes what "formatted" means and turns every
            unrelated pull request red on a rule nobody chose.
        -->
        <spotless-maven-plugin.version>3.10.3</spotless-maven-plugin.version>
        <jacoco-maven-plugin.version>0.8.15</jacoco-maven-plugin.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <!--
            JOSE, which the starter above does not bring.

            This covers both halves of the service's token work: NimbusJwtEncoder/NimbusJwtDecoder
            for the access tokens issued here, and the JWKS-backed decoder that verifies Google's
            identity tokens. The version stays governed by the Spring Boot BOM.

            A note for whoever reads the two together: the starter's own default chain answers every
            request with a generated HTML login page, so SecurityConfiguration must define the real
            chain. Without that bean, every integration test's JSON assertion fails with an
            unexpected '<'. The permit list is therefore explicit and asserted, never inherited.
        -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-oauth2-jose</artifactId>
        </dependency>
        <!--
            Carries FlywayAutoConfiguration. Spring Boot 4 moved autoconfiguration into
            per-technology modules and no declared starter brings this one in, so without it
            spring.flyway.* is inert configuration and migrations never run.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-flyway</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
        <!--
            Pinned. 3.1.1 is the current release and its aggregator POM builds against the same
            Spring Boot 4.1 line this project uses. The widely documented 2.x line targets Boot 3
            and will not work here.
        -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>3.1.1</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- @WebMvcTest and MockMvc; spring-boot-starter-test does not declare them in Boot 4. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- TestRestTemplate and @AutoConfigureTestRestTemplate, likewise split out in Boot 4. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-resttestclient</artifactId>
            <scope>test</scope>
        </dependency>
        <!--
            Carries org.springframework.boot.restclient.RestTemplateBuilder, which
            TestRestTemplateTestAutoConfiguration references. Without it every @SpringBootTest
            context annotated @AutoConfigureTestRestTemplate fails to refresh with
            NoClassDefFoundError while evaluating that autoconfiguration's @ConditionalOnMissingBean.
            spring-boot-resttestclient declares it only as optional, so it must be declared here.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-restclient</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-testcontainers</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Testcontainers 2.x module names. The 1.x names junit-jupiter and postgresql have no
             2.x release and are absent from testcontainers-bom, so they resolve to no version. -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-postgresql</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- SecurityMockMvcRequestPostProcessors, for authenticating a @WebMvcTest slice request
             without minting a real token. -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Absent from the Spring Boot BOM, so the version is pinned here. -->
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
            <version>1.5.1</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!--
                Formatting gate. `spotless:check` is bound to `validate`, so a branch fails before
                anything is compiled and `./mvnw spotless:apply` is the fix.

                No whole-file Java formatter is configured, and that is a decision rather than an
                omission. Both candidates were run against this source tree before choosing:
                palantir-java-format rewrites 437 lines across 17 files, and google-java-format
                AOSP rewraps prose in 12 files, stranding tokens like {@code and orphaning a word
                onto its own comment line. The sources here are wrapped by hand at sentence
                boundaries and carry the reasoning behind decisions, so either formatter would
                trade readable explanation for mechanical column fitting, in a pull request whose
                subject is the deployment pipeline.

                What is enforced is the part that rots silently and that nobody disputes: unused
                imports, import order, trailing whitespace and the final newline. Adopting a full
                formatter remains open, but it is a separate change with a measured cost and its
                own review.
            -->
            <plugin>
                <groupId>com.diffplug.spotless</groupId>
                <artifactId>spotless-maven-plugin</artifactId>
                <version>${spotless-maven-plugin.version}</version>
                <configuration>
                    <java>
                        <!--
                            The order the sources already use: static imports first, then every
                            other import in one ASCII-sorted block with no blank-line groups, so
                            com, jakarta, java and org interleave by name. Declared explicitly
                            because Spotless's default is not this, and an unstated order is a
                            rule that only announces itself by failing someone's build.
                        -->
                        <importOrder>
                            <order>\#,</order>
                        </importOrder>
                        <removeUnusedImports/>
                        <trimTrailingWhitespace/>
                        <endWithNewline/>
                    </java>
                </configuration>
                <executions>
                    <execution>
                        <id>spotless-check</id>
                        <phase>validate</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <!--
                Coverage. Two separate executions and two separate reports because the two test
                tiers run in different phases: Surefire's database-free tests in `test`, Failsafe's
                Testcontainers tests in `integration-test`. A single merged report is deliberately
                not produced, because it would let integration coverage paper over an untested unit, and
                reading them apart is how a thin unit tier stays visible.

                No `check` rule with a minimum ratio is configured. A threshold invented here would
                be a number nobody agreed to, and the first team to hit it deletes an assertion
                rather than writes one. The reports are published as build artifacts so a reviewer
                reads them; agreeing a floor is a separate, explicit decision.
            -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>${jacoco-maven-plugin.version}</version>
                <executions>
                    <execution>
                        <id>unit-prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                        <configuration>
                            <destFile>${project.build.directory}/jacoco-unit.exec</destFile>
                        </configuration>
                    </execution>
                    <execution>
                        <id>unit-report</id>
                        <phase>test</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                        <configuration>
                            <dataFile>${project.build.directory}/jacoco-unit.exec</dataFile>
                            <outputDirectory>${project.reporting.outputDirectory}/jacoco-unit</outputDirectory>
                        </configuration>
                    </execution>
                    <execution>
                        <id>integration-prepare-agent</id>
                        <goals>
                            <goal>prepare-agent-integration</goal>
                        </goals>
                        <configuration>
                            <destFile>${project.build.directory}/jacoco-integration.exec</destFile>
                        </configuration>
                    </execution>
                    <execution>
                        <id>integration-report</id>
                        <phase>post-integration-test</phase>
                        <goals>
                            <goal>report-integration</goal>
                        </goals>
                        <configuration>
                            <dataFile>${project.build.directory}/jacoco-integration.exec</dataFile>
                            <outputDirectory>${project.reporting.outputDirectory}/jacoco-integration</outputDirectory>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <executions>
                    <!-- Writes META-INF/build-info.properties, without which BuildProperties is
                         absent and GET /api/v1/meta can only report an unknown build version. -->
                    <execution>
                        <goals>
                            <goal>build-info</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <!--
                Surefire's default includes (Test*, *Test, *Tests, *TestCase) do not match *IT,
                so database-free tests stay in `test` and Testcontainers-backed *IT classes run
                only in `verify`. This makes `verify` require a Docker daemon.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
