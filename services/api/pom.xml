<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/>
    </parent>

    <groupId>com.rikkaus</groupId>
    <artifactId>rikkaus-wealth-api</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>Rikkaus Wealth OS API</name>
    <description>Backend modular monolith for Rikkaus Wealth OS</description>

    <properties>
        <java.version>25</java.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <!--
            JOSE, which the starter above does not bring.

            This covers both halves of the service's token work: NimbusJwtEncoder/NimbusJwtDecoder
            for the access tokens issued here, and the JWKS-backed decoder that verifies Google's
            identity tokens. The version stays governed by the Spring Boot BOM.

            A note for whoever reads the two together: the starter's own default chain answers every
            request with a generated HTML login page, so SecurityConfiguration must define the real
            chain. Without that bean, every integration test's JSON assertion fails with an
            unexpected '<'. The permit list is therefore explicit and asserted, never inherited.
        -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-oauth2-jose</artifactId>
        </dependency>
        <!--
            Carries FlywayAutoConfiguration. Spring Boot 4 moved autoconfiguration into
            per-technology modules and no declared starter brings this one in, so without it
            spring.flyway.* is inert configuration and migrations never run.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-flyway</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
        <!--
            Pinned. 3.1.1 is the current release and its aggregator POM builds against the same
            Spring Boot 4.1 line this project uses. The widely documented 2.x line targets Boot 3
            and will not work here.
        -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>3.1.1</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- @WebMvcTest and MockMvc; spring-boot-starter-test does not declare them in Boot 4. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- TestRestTemplate and @AutoConfigureTestRestTemplate, likewise split out in Boot 4. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-resttestclient</artifactId>
            <scope>test</scope>
        </dependency>
        <!--
            Carries org.springframework.boot.restclient.RestTemplateBuilder, which
            TestRestTemplateTestAutoConfiguration references. Without it every @SpringBootTest
            context annotated @AutoConfigureTestRestTemplate fails to refresh with
            NoClassDefFoundError while evaluating that autoconfiguration's @ConditionalOnMissingBean.
            spring-boot-resttestclient declares it only as optional, so it must be declared here.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-restclient</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-testcontainers</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Testcontainers 2.x module names. The 1.x names junit-jupiter and postgresql have no
             2.x release and are absent from testcontainers-bom, so they resolve to no version. -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-postgresql</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- SecurityMockMvcRequestPostProcessors, for authenticating a @WebMvcTest slice request
             without minting a real token. -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Absent from the Spring Boot BOM, so the version is pinned here. -->
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
            <version>1.5.1</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <executions>
                    <!-- Writes META-INF/build-info.properties, without which BuildProperties is
                         absent and GET /api/v1/meta can only report an unknown build version. -->
                    <execution>
                        <goals>
                            <goal>build-info</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <!--
                Surefire's default includes (Test*, *Test, *Tests, *TestCase) do not match *IT,
                so database-free tests stay in `test` and Testcontainers-backed *IT classes run
                only in `verify`. This makes `verify` require a Docker daemon.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
