EXPO_PUBLIC_API_BASE_URL=http://localhost:8080

# Google OAuth client per platform (authorization code + PKCE). Leave empty to build without
# Google sign-in; the entry screen then says it is not configured.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=

# Set to `local` only when the API runs under its `local` profile. Shows the development sign-in
# in dev bundles; release builds (`expo export`) never include it.
EXPO_PUBLIC_DEV_SIGN_IN=
