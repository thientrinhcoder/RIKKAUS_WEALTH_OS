  ],
  "steps": [
    { "id": "audit", "label": "Audit Existing Contract", "lane": "design", "kind": "start" },
    { "id": "map", "label": "Map Tokens States Shell", "lane": "design", "kind": "action" },
    { "id": "board", "label": "Build Review Board", "lane": "design", "kind": "action" },
    { "id": "verify", "label": "Verify Evidence", "lane": "design", "kind": "action" },
    { "id": "approve", "label": "Approve Decisions", "lane": "po", "kind": "decision" },
    { "id": "revise", "label": "Reconcile Changes", "lane": "design", "kind": "action" },
